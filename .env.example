# Flask
SECRET_KEY=

# Cookie aman: 1 di produksi HTTPS (VPS), 0/kosong di dev HTTP lokal
HTTPS=0

# Jina AI (embedding)
JINA_API_KEY=

# LLM via 9router (disarankan: ada fallback otomatis ke model lain)
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=GPT-120B-Fallback

# ATAU langsung ke Groq (tanpa router) — isi salah satu, bukan dua-duanya
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Server
HOST=0.0.0.0
PORT=5000

# Origin frontend Vue yang boleh manggil /api/* (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173

# Home web HIMATIF (tujuan tombol back di /chatbot + reverse circle reveal)
# Lokal: http://localhost:5173 | produksi: https://himatif.xxx
HOME_URL=http://localhost:5173
